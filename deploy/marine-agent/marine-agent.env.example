DEEP_AGENT_BASE_URL=https://ai.lebb.chat/v1
DEEP_AGENT_MODEL=MiniMax-M3.1-Flash-Preview
DEEP_AGENT_API_KEY=replace-with-secret
MARINE_AGENT_STATE_DB=/app/results/marine-agent-api/state.sqlite3
MARINE_AGENT_MAX_CONCURRENCY=1
DEEP_AGENT_RECURSION_LIMIT=24
DEEP_AGENT_REQUEST_TIMEOUT_S=180
DEEP_AGENT_MAX_RETRIES=2
DEEP_AGENT_MAX_COMPLETION_TOKENS=12000
# OpenFold3 runs on the registered Apple-MPS worker over the private network.
# Generate and store the token separately; do not put it in the frontend.
OPENFOLD_WORKER_URL=http://100.64.0.22:8099
OPENFOLD_WORKER_TOKEN=replace-with-worker-secret
OPENFOLD_WORKER_TIMEOUT_S=3600
# AutoDock Vina runs on the same Mac worker as OpenFold3.
VINA_WORKER_URL=http://100.64.0.22:8100
VINA_WORKER_TOKEN=replace-with-vina-worker-secret
VINA_WORKER_TIMEOUT_S=7200
VINA_CALLBACK_TOKEN=replace-with-vina-worker-secret
